# Preserve a single pristine algorithm copy for reproducible original/adapted parity.
# Only explicit control plumbing/checkpoints are generated. Every anchor is counted.
function(replace_exact variable old new expected)
  set(rest "${${variable}}")
  set(count 0)
  string(LENGTH "${old}" width)
  while(TRUE)
    string(FIND "${rest}" "${old}" position)
    if(position EQUAL -1)
      break()
    endif()
    math(EXPR count "${count}+1")
    math(EXPR after "${position}+${width}")
    string(SUBSTRING "${rest}" ${after} -1 rest)
  endwhile()
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "Pinned DSP adaptation anchor count ${count}, expected ${expected}: ${old}")
  endif()
  string(REPLACE "${old}" "${new}" changed "${${variable}}")
  set(${variable} "${changed}" PARENT_SCOPE)
endfunction()

