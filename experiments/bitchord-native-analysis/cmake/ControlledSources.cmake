endforeach()
replace_exact(tempo "for (size_t index = 0; index < envelope.size(); ++index) {" "for (size_t index = 0; index < envelope.size(); ++index) {\n    if (index % 1024 == 0) control.checkpoint();" 2)
replace_exact(tempo "for (double& value : envelope) value = std::sqrt(value / peak);" "for (size_t i = 0; i < envelope.size(); ++i) {\n      if (i % 1024 == 0) control.checkpoint();\n      double& value = envelope[i]; value = std::sqrt(value / peak);\n    }" 1)
replace_exact(tempo "for (size_t index = lag; index < length; ++index) {" "for (size_t index = lag; index < length; ++index) {\n    if (index % 1024 == 0) control.checkpoint();" 1)
replace_exact(tempo "for (int phase = 0; phase < phase_count; ++phase) {" "for (int phase = 0; phase < phase_count; ++phase) {\n      control.checkpoint();" 1)
replace_exact(tempo "while (position <= last_frame + 1e-6) {" "while (position <= last_frame + 1e-6) {\n      control.checkpoint();" 1)

