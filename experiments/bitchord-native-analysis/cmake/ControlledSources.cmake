replace_exact(tempo "void Fft(std::vector<std::complex<double>>& values) {" "void Fft(std::vector<std::complex<double>>& values, ${control_parameter}) {\n  control.checkpoint();" 1)
replace_exact(tempo "void NormalizeEnvelope(std::vector<double>& envelope, double frames_per_second) {" "void NormalizeEnvelope(std::vector<double>& envelope, double frames_per_second, ${control_parameter}) {\n  control.checkpoint();" 1)
replace_exact(tempo "  size_t hop_size\n) {" "  size_t hop_size,\n  ${control_parameter}\n) {" 1)
replace_exact(tempo "double Correlation(const std::vector<double>& values, int lag, size_t limit) {" "double Correlation(const std::vector<double>& values, int lag, size_t limit, ${control_parameter}) {" 1)
replace_exact(tempo "TempoResult AnalyzeTempo(" "TempoResult AnalyzeTempoControlled(" 1)
replace_exact(tempo "  double audible_start\n) {" "  double audible_start,\n  ${control_parameter}\n) {\n  control.checkpoint();" 1)
replace_exact(tempo "Fft(spectrum);" "Fft(spectrum, control);" 1)
replace_exact(tempo "OnsetEnvelope(samples, sample_rate, frame_size, hop_size)" "OnsetEnvelope(samples, sample_rate, frame_size, hop_size, control)" 1)
foreach(band full low)
